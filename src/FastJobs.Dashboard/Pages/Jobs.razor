@page "/FastJobs/jobs"
@inherits AutoRefreshComponent
@inject JobDetailService jobsDetailService
<PageTitle>FastJobs — Jobs</PageTitle>
<link rel="stylesheet" href="_content/FastJobs.Dashboard/css/Jobs.css" />

<!-- Top bar -->
<header class="jobs-header page-header">
    <div class="header-left">
        <span class="header-title">Jobs</span>
    </div>
    <!-- Search -->
    <div class="search-container">
        <span class="search-icon ms">search</span>
        <input type="text" placeholder="Search jobs, IDs…" class="search-input" @bind="SearchQuery" @bind:event="oninput"/>
    </div>
</header>

<div class="jobs-container">
    <!-- Stats row -->
    <div class="stats-grid">
        @foreach (var card in StatCards)
        {
            <div class="stat-card stat-card-clickable @(SelectedState == card.State.ToString() ? "selected" : "")" role="button" tabindex="0"
                 @onclick="() => FilterByState(card.State)" @onkeydown="e => OnCardKey(e, card.State)">
                <div class="stat-card-label">@card.Label</div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <div class="stat-card-value @card.Css">@card.Count</div>
                    @if (card.State == JobState.Processing) {  }
                </div>
            </div>
        }
    </div>

    <!-- Filter bar -->
    <div class="filter-bar">
        <span class="filter-label">Filter</span>
        <div class="filter-divider"></div>
        <div class="filter-group">
            <span class="filter-text">Queue</span>
            <select class="filter-select" @bind="SelectedQueue">
                <option value="">All Queues</option>
                <option>default</option>
                <option>critical</option>
                <option>analytics</option>
                <option>low-priority</option>
            </select>
        </div>
        <div class="filter-group">
            <span class="filter-text">State</span>
            <select class="filter-select" @bind="SelectedState">
                <option value="">All States</option>
                @foreach (var st in Enum.GetValues<JobState>().Where(x => x != JobState.Dequeued))
                {
                    <option value="@st">@StateDisplay.Label(st)</option>
                }
            </select>
        </div>
        <div class="filter-group">
            <span class="filter-text">Sort</span>
            <select class="filter-select" @bind="SortBy">
                <option>CreatedAt ↓</option>
                <option>CreatedAt ↑</option>
                <option>Duration ↓</option>
                <option>AttemptCount ↓</option>
            </select>
        </div>
        <div class="filter-actions">
            <button class="filter-button filter-button-clear" @onclick="ClearFilters">Clear</button>
            <button class="filter-button filter-button-apply" @onclick="ApplyFilters">Apply</button>
        </div>
    </div>

    <!-- Table -->
    <div class="table-wrapper">
        <div class="table-container">
            <table class="jobs-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Job Name</th>
                        <th>Queue</th>
                        <th>State</th>
                        <th>Created</th>
                        <th>Started</th>
                        <th>Duration</th>
                        <th>Attempts</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in PagedJobs)
                    {
                        <tr>
                            <td class="table-cell-id">#@job.Id</td>
                            <td class="table-cell-name" title="@job.JobName">@DisplayFormat.JobName(job.JobName, job.MethodName)</td>
                            <td><span class="table-cell-queue">@job.QueueName</span></td>
                            <td><JobStateIcon Job="job" /></td>
                            <td class="table-cell-time">@TimeDisplay.Utc(job.CreatedAt, "MMM dd, HH:mm")</td>
                            <td class="table-cell-time">@TimeDisplay.Utc(job.StartedAt, "HH:mm:ss")</td>
                            <td class="table-cell-duration">@DisplayFormat.Duration(job.Duration)</td>
                            <td class="table-cell-attempts">@job.AttemptCount</td>
                            <td class="table-cell-actions">
                                <button class="table-action-button ms">more_vert</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!FilteredJobs.Any())
        {
            <div class="empty-state">No jobs match the current filters.</div>
        }
        <!-- Pagination -->
        <div class="pagination-container">
            <span class="pagination-info">Showing @(FilteredJobs.Count == 0 ? 0 : (CurrentPage - 1) * PageSize + 1)–@Math.Min(CurrentPage * PageSize, FilteredJobs.Count) of <strong>@FilteredJobs.Count</strong></span>
            <div class="pagination-buttons">
                <button class="pagination-button" disabled="@(CurrentPage <= 1)" @onclick="() => GoToPage(CurrentPage - 1)">‹ Prev</button>
                <span class="pagination-info">Page @CurrentPage of @TotalPages</span>
                <button class="pagination-button" disabled="@(CurrentPage >= TotalPages)" @onclick="() => GoToPage(CurrentPage + 1)">Next ›</button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<JobDetailModel> AllJobs { get; set; } = new();
    private List<JobDetailModel> FilteredJobs { get; set; } = new();
    private JobStatsModel JobStats { get; set; } = new();

    private string _searchQuery = "";
    private string SearchQuery
    {
        get => _searchQuery;
        set { _searchQuery = value; CurrentPage = 1; ApplyFilters(); }
    }
    private string SelectedQueue { get; set; } = "";
    private string SelectedState { get; set; } = "";
    private string SortBy { get; set; } = "CreatedAt ↓";
    private const int PageSize = 25;
    private int CurrentPage { get; set; } = 1;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredJobs.Count / (double)PageSize));
    private IEnumerable<JobDetailModel> PagedJobs => FilteredJobs.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private record StatCard(string Label, JobState State, int Count, string Css);
    private IEnumerable<StatCard> StatCards => new[]
    {
        new StatCard("Enqueued", JobState.Enqueued, JobStats.Enqueued, ""),
        new StatCard("Scheduled", JobState.Scheduled, JobStats.Scheduled, "info"),
        new StatCard("Processing", JobState.Processing, JobStats.Processing, "info"),
        new StatCard("Succeeded", JobState.Completed, JobStats.Succeeded, "accent"),
        new StatCard("Failed", JobState.Failed, JobStats.Failed, "danger"),
        new StatCard("Retrying", JobState.Retrying, JobStats.Retrying, "warn"),
        new StatCard("Cancelled", JobState.Deleted, JobStats.Cancelled, "dim"),
    };

    private void OnCardKey(KeyboardEventArgs e, JobState state)
    {
        if (e.Key == "Enter") FilterByState(state);
    }

    private void FilterByState(JobState state)
    {
        SelectedState = SelectedState == state.ToString() ? "" : state.ToString();
        ApplyFilters();
    }

    private void GoToPage(int page) => CurrentPage = Math.Clamp(page, 1, TotalPages);

    protected override TimeSpan RefreshInterval => TimeSpan.FromSeconds(10);

    protected override async Task LoadData()
    {
        AllJobs = await GetJobs();
        JobStats = CalculateStats(AllJobs);
        ApplyFilters();
    }

    private async Task<List<JobDetailModel>> GetJobs()
    {
       return (await jobsDetailService.GetAllJobDetailsAsync()).ToList();
    }

    private JobStatsModel CalculateStats(List<JobDetailModel> jobs)
    {
        return new JobStatsModel
        {
            Enqueued = jobs.Count(j => j.State == JobState.Enqueued),
            Scheduled = jobs.Count(j => j.State == JobState.Scheduled),
            Processing = jobs.Count(j => j.State == JobState.Processing),
            Succeeded = jobs.Count(j => j.State == JobState.Completed),
            Failed = jobs.Count(j => j.State == JobState.Failed),
            Retrying = jobs.Count(j => j.State == JobState.Retrying),
            Cancelled = jobs.Count(j => j.State == JobState.Deleted)
        };
    }

    private void ApplyFilters()
    {
        var filtered = AllJobs.AsQueryable();

        if (!string.IsNullOrEmpty(SearchQuery))
        {
            filtered = filtered.Where(j => j.JobName.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) || j.Id.ToString() == SearchQuery.TrimStart('#'));
        }

        if (!string.IsNullOrEmpty(SelectedQueue))
        {
            filtered = filtered.Where(j => j.QueueName == SelectedQueue);
        }

        if (!string.IsNullOrEmpty(SelectedState) && Enum.TryParse<JobState>(SelectedState, out var state))
        {
            filtered = filtered.Where(j => j.State == state);
        }

        // Simple sorting
        filtered = SortBy switch
        {
            "CreatedAt ↓" => filtered.OrderByDescending(j => j.CreatedAt),
            "CreatedAt ↑" => filtered.OrderBy(j => j.CreatedAt),
            "Duration ↓" => filtered.OrderByDescending(j => j.Duration),
            "AttemptCount ↓" => filtered.OrderByDescending(j => j.AttemptCount),
            _ => filtered.OrderByDescending(j => j.CreatedAt)
        };

        FilteredJobs = filtered.ToList();
        CurrentPage = Math.Clamp(CurrentPage, 1, TotalPages);
    }

    private void ClearFilters()
    {
        _searchQuery = "";
        SelectedQueue = "";
        SelectedState = "";
        SortBy = "CreatedAt ↓";
        ApplyFilters();
    }


    private class JobStatsModel
    {
        public int Enqueued { get; set; }
        public int Scheduled { get; set; }
        public int Processing { get; set; }
        public int Succeeded { get; set; }
        public int Failed { get; set; }
        public int Retrying { get; set; }
        public int Cancelled { get; set; }
    }
}