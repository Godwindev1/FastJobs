@using Microsoft.AspNetCore.Components.Routing
@using static Microsoft.AspNetCore.Components.Web.RenderMode

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <base href="/" />
    <link href="_content/FastJobs.Dashboard/css/site.css?v=2" rel="stylesheet" />

    <script src="_content/FastJobs.Dashboard/js/theme.js?v=2"></script>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />

    @* Suppress RZ9992 - this component is intentionally the document root shell *@
    @{
        #pragma warning disable RZ9992;
        <script src="_framework/blazor.web.js"></script>
        <script src="_content/FastJobs.Dashboard/js/timestamps.js?v=2"></script>
        #pragma warning restore RZ9992;
    }
</body>
</html>