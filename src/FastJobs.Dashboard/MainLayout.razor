@inherits LayoutComponentBase

<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@400,0&display=swap" rel="stylesheet"/>
<link href="css/site.css?v=2" rel="stylesheet"/>

<div class="app-shell">
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-text">
                <a href="./" class="nav-logo">
                    <span class="logo-text">FastJobs</span>
                    <span class="logo-dot"></span>
                    <span class="logo-tld">.tech</span>
                </a>
            </div>
        </div>
        <nav class="sidebar-nav">
            @foreach (var item in NavItems)
            {
                <a href="@(item.Path == "" ? "./" : item.Path.TrimStart('/'))" class="nav-item @GetNavClass(item.Path)" title="@item.Label">
                    <span class="ms">@item.Icon</span><span class="nav-label">@item.Label</span>
                </a>
            }
        </nav>
        <div class="sidebar-foot">
            <button type="button" class="nav-item" data-time-toggle onclick="fastJobsToggleLocalTime()" title="Toggle time display">
                <span class="ms">schedule</span><span class="nav-label">Show Local Time</span>
            </button>
            <a href="settings" class="nav-item @GetNavClass("/settings")" title="Settings">
                <span class="ms">settings</span><span class="nav-label">Settings</span>
            </a>
        </div>
    </aside>

    <div class="main-col">
        <header class="topbar">
            <div class="topbar-left">
                <button type="button" class="icon-button" onclick="fastJobsToggleSidebar()" title="Collapse or expand sidebar" aria-label="Toggle sidebar"><span class="ms">menu</span></button>
                <nav class="breadcrumbs" aria-label="Breadcrumb">
                    <a href="./">FastJobs</a>
                    <span class="ms crumb-sep">chevron_right</span>
                    <span class="crumb-current">@CurrentTitle</span>
                </nav>
            </div>
            <div class="topbar-right">
                <button type="button" class="icon-button" onclick="fastJobsToggleTheme()" title="Toggle theme" aria-label="Toggle theme">
                    <span class="ms" data-theme-icon>dark_mode</span>
                </button>
            </div>
        </header>
        <main class="content">
            @Body
        </main>
    </div>
</div>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private static readonly string Version =
        typeof(MainLayout).Assembly.GetName().Version?.ToString(3) ?? "1.0.0";

    private record NavEntry(string Path, string Label, string Icon);

    private static readonly NavEntry[] NavItems =
    {
        new("", "Overview", "dashboard"),
        new("/jobs", "Jobs", "list_alt"),
        new("/workers", "Workers", "engineering"),
        new("/recurring", "Recurring", "autorenew"),
        new("/scheduled", "Scheduled", "schedule"),
    };

    private string CurrentPath => "/" + DashboardPath.Relative(Navigation);

    private string CurrentTitle
    {
        get
        {
            var path = CurrentPath;
            if (path.EndsWith("/settings", StringComparison.OrdinalIgnoreCase)) return "Settings";
            return NavItems.FirstOrDefault(n => n.Path != "" && path.EndsWith(n.Path, StringComparison.OrdinalIgnoreCase))?.Label
                   ?? "Overview";
        }
    }

    private string GetNavClass(string href) =>
        string.Equals(CurrentPath.TrimEnd('/'), href, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
